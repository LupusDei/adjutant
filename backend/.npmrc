# adj-juy35: make an engines violation an ERROR, not a warning.
#
# Two Node versions live on this box (v22 for the fleet's other project, v20 for
# adjutant's launchd job). An npm install from a v22 shell silently recompiles
# better-sqlite3 for NODE_MODULE_VERSION 127; the backend then dies with
# ERR_DLOPEN_FAILED before it binds and crash-loops behind launchd KeepAlive.
#
# npm only WARNS on an engines mismatch by default (EBADENGINE), which is how
# that got through. engine-strict turns the warning into a refusal — the install
# fails in the shell of the person doing it, instead of production failing later.
engine-strict=true
